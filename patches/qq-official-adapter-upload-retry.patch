+    async def _put_image_part(self, session: ClientSession, url: str, chunk: bytes, index: int) -> None:
+        """PUT同一预签名分片可安全重传；不重放群消息POST，不记录带签名的URL。"""
+        for attempt in range(3):
+            try:
+                async with session.put(url, data=chunk, timeout=ClientTimeout(total=12, connect=5)) as response:
+                    if response.status >= 400:
+                        raise RuntimeError(f"QQ 图片分片 {index} 上传失败: HTTP {response.status}")
+                    # 完整读取响应后才确认该分片；响应中途断开时仍可安全重传相同字节。
+                    await response.read()
+                return
+            except (ClientConnectionError, ClientPayloadError, asyncio.TimeoutError) as exc:
+                if attempt == 2:
+                    raise RuntimeError(f"QQ 图片分片 {index} 上传连接失败，已尝试3次（{type(exc).__name__}）") from exc
+                connector = session.connector
+                if connector is not None:
+                    host = urlsplit(url)
+                    connector.clear_dns_cache(host.hostname, host.port or 443)
+                self.ctx.logger.warning("QQ 图片分片上传连接中断，刷新DNS重试: part=%s attempt=%s error=%s",
+                                        index, attempt+1, type(exc).__name__)
+                await asyncio.sleep(0.5 * (attempt+1))
+
 
