{
  "manifest_version": 2,
  "plugin_type": "tool",
  "id": "wu.group-timetable",
  "name": "群聊个人课表提醒",
  "version": "1.10.0",
  "description": "支持文字图片识别课表、批量增删与确认、群友后续课程图片盘点、当前上课汇总、管理员代管及ICS/WakeUp提醒",
  "author": {"name": "Wu", "url": "https://github.com/uFay0411"},
  "license": "GPL-3.0-or-later",
  "urls": {
    "repository": "https://github.com/uFay0411/maibot-group-timetable",
    "homepage": "https://github.com/uFay0411/maibot-group-timetable",
    "documentation": "https://github.com/uFay0411/maibot-group-timetable/blob/main/README.md",
    "issues": "https://github.com/uFay0411/maibot-group-timetable/issues"
  },
  "i18n": {"default_locale": "zh-CN", "supported_locales": ["zh-CN"]},
  "host_application": {"min_version": "1.3.15", "max_version": "1.3.99"},
  "sdk": {"min_version": "2.16.0", "max_version": "2.99.99"},
  "dependencies": [
    {"type": "python_package", "name": "icalendar", "version_spec": ">=6.3,<8"},
    {"type": "python_package", "name": "recurring-ical-events", "version_spec": ">=3.8,<4"},
    {"type": "python_package", "name": "tzdata", "version_spec": ">=2025.1"},
    {"type": "python_package", "name": "httpx", "version_spec": ">=0.27,<1"},
    {"type": "python_package", "name": "Pillow", "version_spec": ">=10,<14"}
  ],
  "capabilities": ["send.text", "send.hybrid", "maisaka.reply.generate", "message.get_by_id", "api.call", "api.list", "llm.generate", "maisaka.context.resolve_image"]
}
